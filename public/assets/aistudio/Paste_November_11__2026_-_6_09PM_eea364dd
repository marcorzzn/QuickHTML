      const f = inp.files[0]; if (!f) return;
      const r = new FileReader();
      r.onload = () => {
        try {
          model = JSON.parse(r.result);
          $('#app-name').value = model.name;
          renderCanvas(); renderParams(); renderPalette();
        } catch(e) { toast('JSON non valido'); }
      };
      r.readAsText(f);
    };
    inp.click();
  });
}
init();
