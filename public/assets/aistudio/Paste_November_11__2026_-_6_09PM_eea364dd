/* ============================================================
   2. MODEL
   ============================================================ */
const emptyModel = () => ({
  name:'Nuova app',
  regions:{ header:[], main:[], footer:[] },
  customCSS:'',
  customJS:''
});

let model = emptyModel();
let selected = null;

/* ============================================================
   3. HELPERS
   ============================================================ */
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const escapeHTML = s => String(s ?? '').replace(/[&<>"']/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function defaultProps(reg) {
  const out = {};
  (reg.config || []).forEach(c => out[c.key] = c.default);
  return out;
}

function renderTemplate(tpl, props, reg) {
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, key) => {
    let v = props[key] ?? '';
    if (key === 'options') {
      return String(v).split(',').map(x => `<option>${escapeHTML(x.trim())}</option>`).join('');
    }
    const cfg = (reg.config || []).find(c => c.key === key);
    if (cfg?.raw) return String(v);
    return escapeHTML(String(v));
  });
}

/* ============================================================
   4. RENDERING
   ============================================================ */
function injectComponentStyles() {
  let el = document.getElementById('component-styles');
  if (!el) { el = document.createElement('style'); el.id = 'component-styles'; document.head.appendChild(el); }
  el.textContent = Object.values(REGISTRY).map(r => r.css || '').join('\n');
}

function renderCanvas() {
  $$('.region').forEach(regionEl => {
    const region = regionEl.dataset.region;
    regionEl.querySelectorAll('.block').forEach(b => b.remove());
    const blocks = model.regions[region] || [];
    blocks.forEach((block, i) => {
      const reg = REGISTRY[block.component];
      if (!reg) return;
      const props = { ...defaultProps(reg), ...block.props };
      const div = document.createElement('div');
      div.className = 'block' + (selected?.region === region && selected?.index === i ? ' selected' : '');
      div.innerHTML = renderTemplate(reg.html, props, reg);

      const tools = document.createElement('div');
      tools.className = 'block-tools';
      tools.innerHTML = `<button data-act="up">↑</button><button data-act="down">↓</button><button data-act="dup">⎘</button><button data-act="del">✕</button>`;
      tools.addEventListener('click', e => {
        e.stopPropagation();
        const act = e.target.dataset.act;
        if (!act) return;
        if (act === 'up' && i > 0) [blocks[i-1], blocks[i]] = [blocks[i], blocks[i-1]];
        if (act === 'down' && i < blocks.length - 1) [blocks[i+1], blocks[i]] = [blocks[i], blocks[i+1]];
        if (act === 'dup') blocks.splice(i+1, 0, JSON.parse(JSON.stringify(block)));
        if (act === 'del') blocks.splice(i, 1);
        selected = null;
        renderCanvas(); renderParams();
      });
      div.appendChild(tools);

      div.addEventListener('click', e => {
        e.stopPropagation();
        selected = { region, index:i };
        renderCanvas(); renderParams();
      });
      regionEl.appendChild(div);
    });
  });
}

function renderPalette() {
  const search = ($('#search').value || '').toLowerCase();
  const cats = {};
  Object.entries(REGISTRY).forEach(([id, reg]) => {
    if (search && !reg.label.toLowerCase().includes(search) && !id.toLowerCase().includes(search)) return;
    (cats[reg.category] ||= []).push({ id, ...reg });
  });
  $('#palette-list').innerHTML = Object.entries(cats).map(([cat, items]) => `
    <div class="palette-cat">
      <h4>${cat}</h4>
      ${items.map(it => `<button class="palette-btn" data-id="${it.id}">
        <span class="pic">${it.icon || '•'}</span><span>${it.label}</span>
      </button>`).join('')}
    </div>`).join('');
  $$('.palette-btn').forEach(b => b.addEventListener('click', () => addComponent(b.dataset.id)));
}

function addComponent(id) {
  const reg = REGISTRY[id];
  if (!reg) return;
  const target = selected?.region || 'main';
  model.regions[target] ||= [];
  model.regions[target].push({ component:id, props: defaultProps(reg) });
  selected = { region:target, index: model.regions[target].length - 1 };
  renderCanvas(); renderParams();
}

function renderParams() {
  const body = $('#params-body');
  if (!selected) {
    body.innerHTML = '<p class="hint">Seleziona un componente sulla tela.</p>';
    return;
  }
  const block = model.regions[selected.region]?.[selected.index];
  if (!block) { selected = null; return renderParams(); }
  const reg = REGISTRY[block.component];
  const props = { ...defaultProps(reg), ...block.props };
  let html = `<h4>${reg.label}</h4>`;
  (reg.config || []).forEach(cfg => {
    html += `<label class="field"><span>${cfg.label}</span>`;
    if (cfg.type === 'textarea') {
      html += `<textarea data-key="${cfg.key}">${escapeHTML(props[cfg.key] ?? '')}</textarea>`;
    } else if (cfg.type === 'select') {
      html += `<select data-key="${cfg.key}">${cfg.options.map(o =>
        `<option value="${escapeHTML(o)}" ${o == props[cfg.key] ? 'selected' : ''}>${escapeHTML(o)}</option>`
      ).join('')}</select>`;
    } else if (cfg.type === 'number') {
      html += `<input type="number" data-key="${cfg.key}" value="${escapeHTML(props[cfg.key] ?? '')}">`;
    } else {
      html += `<input type="text" data-key="${cfg.key}" value="${escapeHTML(props[cfg.key] ?? '')}">`;
    }
    if (cfg.hint) html += `<small>${cfg.hint}</small>`;
    html += `</label>`;
  });
  html += `<button class="btn-danger" id="del-block">Elimina componente</button>`;
  body.innerHTML = html;
  body.querySelectorAll('[data-key]').forEach(el => {
    el.addEventListener('input', () => {
      block.props[el.dataset.key] = el.value;
      renderCanvas();
    });
  });
  $('#del-block').addEventListener('click', () => {
    model.regions[selected.region].splice(selected.index, 1);
    selected = null;
    renderCanvas(); renderParams();
  });
}

/* ============================================================
   5. BUILD FINAL HTML
   ============================================================ */
function buildHTML() {
  const used = new Set();
  const sections = {};
  for (const [region, blocks] of Object.entries(model.regions)) {
    sections[region] = (blocks || []).map(b => {
      used.add(b.component);
      const reg = REGISTRY[b.component];
      const props = { ...defaultProps(reg), ...b.props };
      return `<div class="af-block">${renderTemplate(reg.html, props, reg)}</div>`;
    }).join('\n');
  }
  const css = [...used].map(id => REGISTRY[id].css || '').join('\n');
  const js  = [...used].map(id => REGISTRY[id].js  || '').join('\n');

  return `<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapeHTML(model.name)}</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,sans-serif;background:#fafafa;color:#1a1a1a}
  .af-app{display:flex;flex-direction:column;min-height:100vh}
  .af-header{padding:1rem 1.5rem;background:#fff;border-bottom:1px solid #e2e2e2}
  .af-main{padding:1.5rem;flex:1;max-width:1000px;margin:0 auto;width:100%}
  .af-footer{padding:1rem 1.5rem;background:#f4f4f4;border-top:1px solid #e2e2e2;font-size:.85rem;color:#666}
  .af-block{margin:0 0 1rem}
  ${css}
  ${model.customCSS || ''}
</style>
</head>
<body>
<div class="af-app">
  ${sections.header ? `<header class="af-header">${sections.header}</header>` : ''}
  <main class="af-main">${sections.main || ''}</main>
  ${sections.footer ? `<footer class="af-footer">${sections.footer}</footer>` : ''}
</div>
<script type="module">
${js}
${model.customJS || ''}
<\/script>
</body>
</html>`;
}

/* ============================================================
   6. PREVIEW / EXPORT
   ============================================================ */
function openPreview() {
  $('#preview-frame').srcdoc = buildHTML();
  $('#preview-modal').classList.add('open');
}
function closePreview() { $('#preview-modal').classList.remove('open'); }

function exportHTML() {
  const blob = new Blob([buildHTML()], { type:'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = (model.name || 'app') + '.html';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  toast('HTML esportato');
}

/* ============================================================
   7. TEMPLATES
   ============================================================ */
const TEMPLATES = {
  'vuoto': emptyModel,
  'editor video': () => ({
