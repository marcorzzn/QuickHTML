  $('#btn-preview').addEventListener('click', openPreview);
  $('#btn-templates').addEventListener('click', openTemplates);
  $('#btn-new').addEventListener('click', () => {
    if (!confirm('Nuova app?')) return;
    model = emptyModel(); selected = null;
