function openTemplates() {
  $('#templates-grid').innerHTML = Object.keys(TEMPLATES).map(id =>
    `<button class="tpl-card" data-tpl="${id}">${id}</button>`).join('');
  $$('.tpl-card').forEach(b => b.addEventListener('click', () => {
