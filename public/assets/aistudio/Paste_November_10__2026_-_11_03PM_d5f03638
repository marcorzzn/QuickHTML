<body>
<div class="app">
  <aside>
    <h2>Testo</h2>
    <button data-textblock="p">¶ Paragrafo</button>
    <button data-textblock="h1">H1</button>
    <button data-textblock="h2">H2</button>
    <button data-textblock="quote">" Citazione</button>

    <h2>Elementi</h2>
    <button data-element="button">🔘 Button</button>
    <button data-element="a">🔗 Link</button>
    <button data-element="img">🖼 Immagine</button>
    <button data-element="input">⌨ Input</button>
    <button data-element="hr">— Riga</button>

    <h2>Snippet</h2>
    <button data-snippet="card">🃏 Card</button>
    <button data-snippet="nav">🧭 Navigazione</button>
    <button data-snippet="form">📝 Form</button>
    <button data-snippet="table">📊 Tabella</button>

    <h2>Azioni</h2>
    <button id="show-html">&lt;/&gt; Vedi HTML</button>
    <button id="save">💾 Salva</button>
    <button id="load">📂 Carica</button>
  </aside>

  <main>
    <div class="toolbar-inline" role="toolbar" aria-label="Formattazione testo">
      <button data-inline="bold"><strong>B</strong></button>
      <button data-inline="italic"><em>I</em></button>
      <button data-inline="link">🔗</button>
    </div>
    <div id="editor"></div>
  </main>

  <aside>
    <iframe id="preview" sandbox="allow-scripts allow-modals allow-forms"></iframe>
  </aside>
</div>

<script>
/* ============================================================
   MODELLO
   block =
     { kind:'text',    type:'p'|'h1'|'h2'|'quote', runs:[{text,marks}] }
     { kind:'element', tag:'button'|'a'|'img'|'input'|'hr',
                       text?:string, attrs:{...} }
     { kind:'snippet', name:string, html:string }
   Il modello non conosce né HTML né CSS: descrive significato.
   ============================================================ */

const ELEMENT_DEFAULTS = {
  button: { tag:'button', text:'Clicca', attrs:{ onclick:"alert('Ciao!')" } },
  a:      { tag:'a',      text:'Link',   attrs:{ href:'https://example.com' } },
  img:    { tag:'img',    attrs:{ src:'https://picsum.photos/200/100', alt:'Immagine' } },
  input:  { tag:'input',  attrs:{ type:'text', placeholder:'Scrivi qui...' } },
  hr:     { tag:'hr',     attrs:{} },
};

const SNIPPETS = {
  card: `<div class="card"><h3>Titolo card</h3><p>Contenuto della card.</p></div>`,
  nav:  `<nav><a href="#">Home</a><a href="#">Chi siamo</a><a href="#">Contatti</a></nav>`,
  form: `<form onsubmit="event.preventDefault();alert('Inviato!');">
  <label>Nome: <input type="text" name="nome"></label>
  <button type="submit">Invia</button>
</form>`,
  table:`<table><thead><tr><th>A</th><th>B</th></tr></thead>
  <tbody><tr><td>1</td><td>2</td></tr><tr><td>3</td><td>4</td></tr></tbody></table>`,
};

let model = [
  { kind:'text', type:'h1', runs:[{text:'La mia pagina', marks:{}}] },
  { kind:'text', type:'p', runs:[{text:'Clicca il pulsante qui sotto.', marks:{}}] },
  { kind:'element', tag:'button', text:'Clicca',
    attrs:{ onclick:"alert('Ciao dal pulsante!')" } },
];

/* ============================================================
   MAPPING MODELLO → HTML
   Qui si decide cosa significa ogni blocco sul target HTML.
   ============================================================ */

function escapeHTML(s='') {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
                  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderRun(r) {
  let t = escapeHTML(r.text || '');
  const m = r.marks || {};
  if (m.link)   t = `<a href="${escapeHTML(m.link)}">${t}</a>`;
  if (m.italic) t = `<em>${t}</em>`;
  if (m.bold)   t = `<strong>${t}</strong>`;
  return t;
}

const TEXT_TAGS = { p:'p', h1:'h1', h2:'h2', quote:'blockquote' };

function renderBlockHTML(b) {
  if (b.kind === 'text') {
    const tag = TEXT_TAGS[b.type] || 'p';
    const inner = (b.runs || []).map(renderRun).join('');
    return `<${tag}>${inner}</${tag}>`;
  }
  if (b.kind === 'element') {
    const attrs = Object.entries(b.attrs || {})
      .map(([k,v]) => ` ${k}="${escapeHTML(v)}"`).join('');
    if (['img','hr','input'].includes(b.tag)) return `<${b.tag}${attrs}>`;
    return `<${b.tag}${attrs}>${escapeHTML(b.text || '')}</${b.tag}>`;
  }
  if (b.kind === 'snippet') return b.html;
  return '';
}

function buildDocument() {
  const body = model.map(renderBlockHTML).join('\n');
  return `<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">
<title>Preview</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 1.5rem auto;
         padding: 0 1rem; line-height: 1.6; color:#1a1a1a; }
  button { padding:.5rem 1rem; border:1px solid #0b5fff; background:#0b5fff;
           color:white; border-radius:6px; cursor:pointer; }
  a { color:#0b5fff; } img { max-width:100%; }
  blockquote { border-left:3px solid #0b5fff; margin:.5rem 0; padding-left:1rem; color:#555; }
  .card { border:1px solid #ddd; border-radius:8px; padding:1rem; margin:.5rem 0; }
  nav { display:flex; gap:1rem; padding:.5rem 0; border-bottom:1px solid #ddd; }
  table { border-collapse:collapse; width:100%; }
  td, th { border:1px solid #ddd; padding:.5rem; text-align:left; }
</style></head><body>${body}</body></html>`;
}

/* ============================================================
   MAPPING HTML → MODELLO (inverso)
   ============================================================ */
const KNOWN_INLINE = { STRONG:'bold', B:'bold', EM:'italic', I:'italic' };

function parseInlineNodes(nodes, marks = {}) {
  const runs = [];
  for (const node of nodes) {
    if (node.nodeType === Node.TEXT_NODE) {
      if (node.textContent) runs.push({ text: node.textContent, marks: {...marks} });
    } else if (node.nodeType === Node.ELEMENT_NODE) {
      if (node.tagName === 'BR') runs.push({ text:'\n', marks:{...marks} });
      else if (node.tagName === 'A')
        runs.push(...parseInlineNodes(node.childNodes, { ...marks, link: node.getAttribute('href') || '' }));
      else if (KNOWN_INLINE[node.tagName])
        runs.push(...parseInlineNodes(node.childNodes, { ...marks, [KNOWN_INLINE[node.tagName]]: true }));
      else
        runs.push(...parseInlineNodes(node.childNodes, marks));
    }
  }
  return runs;
}

/* ============================================================
   RENDER EDITOR
   Ogni blocco ha: contenuto editabile + mini-toolbar (su/giù/dup/elimina).
   ============================================================ */
const editorEl = document.getElementById('editor');
const previewEl = document.getElementById('preview');

let previewTimer = null;
function updatePreview() {
  clearTimeout(previewTimer);
  previewTimer = setTimeout(() => { previewEl.srcdoc = buildDocument(); }, 120);
}

function renderEditor() {
  editorEl.innerHTML = '';
  model.forEach((block, idx) => {
    const wrap = document.createElement('div');
    wrap.className = 'block';

    const tools = document.createElement('div');
    tools.className = 'block-tools';
    tools.innerHTML = `<button data-act="up" title="Su">↑</button>
      <button data-act="down" title="Giù">↓</button>
      <button data-act="dup" title="Duplica">⎘</button>
      <button data-act="del" title="Elimina">✕</button>`;
    tools.addEventListener('click', e => {
      const act = e.target.dataset.act;
      if (!act) return;
      if (act === 'up'   && idx > 0)               [model[idx-1], model[idx]] = [model[idx], model[idx-1]];
      if (act === 'down' && idx < model.length-1)  [model[idx+1], model[idx]] = [model[idx], model[idx+1]];
      if (act === 'dup')  model.splice(idx+1, 0, JSON.parse(JSON.stringify(block)));
      if (act === 'del')  model.splice(idx, 1);
      renderEditor(); updatePreview();
    });
    wrap.appendChild(tools);

    const content = document.createElement('div');

    if (block.kind === 'text') {
      content.innerHTML = renderBlockHTML(block);
      const el = content.firstElementChild;
      el.setAttribute('contenteditable', 'true');
      el.addEventListener('input', () => {
        model[idx].runs = parseInlineNodes(el.childNodes);
        updatePreview();
      });
      el.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          model.splice(idx+1, 0, { kind:'text', type:'p', runs:[] });
          renderEditor(); updatePreview();
          setTimeout(() => focusBlock(idx+1), 0);
        }
      });
    } else if (block.kind === 'element') {
      content.innerHTML = `<div class="render-preview">${renderBlockHTML(block)}</div>`;
      const btn = document.createElement('button');
      btn.className = 'props-btn';
      btn.textContent = '⚙ Configura';
      btn.addEventListener('click', () => openElementProps(idx));
      content.appendChild(btn);
    } else if (block.kind === 'snippet') {
      content.innerHTML = `<div class="render-preview">${block.html}</div>`;
      const btn = document.createElement('button');
      btn.className = 'props-btn';
      btn.textContent = '⚙ Modifica HTML';
      btn.addEventListener('click', () => openSnippetProps(idx));
      content.appendChild(btn);
    }

    wrap.appendChild(content);
    editorEl.appendChild(wrap);
  });
}

function focusBlock(idx) {
  const wrap = editorEl.querySelectorAll('.block')[idx];
  const ed = wrap?.querySelector('[contenteditable]');
  if (!ed) return;
  ed.focus();
  const r = document.createRange();
  r.selectNodeContents(ed); r.collapse(false);
  const s = window.getSelection();
  s.removeAllRanges(); s.addRange(r);
}

/* ============================================================
   FORM DI CONFIGURAZIONE PER ELEMENTI
   La "UI che ti permette di fare una certa cosa".
   ============================================================ */
function openElementProps(idx) {
  const block = model[idx];
  const dlg = document.createElement('dialog');
  let fields = '';

  if (block.tag === 'button') {
    const onclick = block.attrs.onclick || '';
    const isAlert = onclick.startsWith('alert');
    fields = `
      <label>Testo: <input name="text" value="${escapeHTML(block.text||'')}"></label>
      <label>Azione:
        <select name="action">
          <option value="alert" ${isAlert?'selected':''}>Mostra avviso</option>
          <option value="none"  ${!onclick?'selected':''}>Nessuna</option>
          <option value="custom"${onclick && !isAlert?'selected':''}>Personalizzata</option>
        </select></label>
      <label name="custom-wrap" style="display:${!isAlert&&onclick?'block':'none'}">
        JS: <input name="custom" value="${escapeHTML(isAlert?'':onclick)}"></label>`;
  } else if (block.tag === 'a') {
    fields = `<label>Testo: <input name="text" value="${escapeHTML(block.text||'')}"></label>
              <label>URL: <input name="href" value="${escapeHTML(block.attrs.href||'')}"></label>`;
  } else if (block.tag === 'img') {
    fields = `<label>URL: <input name="src" value="${escapeHTML(block.attrs.src||'')}"></label>
              <label>Alt: <input name="alt" value="${escapeHTML(block.attrs.alt||'')}"></label>`;
  } else if (block.tag === 'input') {
    fields = `<label>Tipo:
        <select name="type">
          ${['text','email','number','password'].map(t =>
            `<option value="${t}" ${block.attrs.type===t?'selected':''}>${t}</option>`).join('')}
        </select></label>
      <label>Placeholder: <input name="placeholder" value="${escapeHTML(block.attrs.placeholder||'')}"></label>`;
  } else {
    fields = `<p>Nessun attributo.</p>`;
  }

  dlg.innerHTML = `<form method="dialog"><h3>Modifica &lt;${block.tag}&gt;</h3>
    ${fields}<menu><button value="cancel">Annulla</button>
    <button value="ok" type="submit">Salva</button></menu></form>`;
  document.body.appendChild(dlg); dlg.showModal();

  const actionSel = dlg.querySelector('select[name="action"]');
  if (actionSel) actionSel.addEventListener('change', () => {
    dlg.querySelector('label[name="custom-wrap"]').style.display =
      actionSel.value === 'custom' ? 'block' : 'none';
  });

  dlg.addEventListener('close', () => {
    if (dlg.returnValue !== 'ok') { dlg.remove(); return; }
    const get = n => dlg.querySelector(`[name="${n}"]`)?.value;
    if (block.tag === 'button') {
      block.text = get('text') || 'Clicca';
      const a = get('action');
      if (a === 'alert') block.attrs.onclick = `alert('Ciao!')`;
      else if (a === 'none') delete block.attrs.onclick;
      else block.attrs.onclick = get('custom') || '';
    } else if (block.tag === 'a') {
      block.text = get('text') || 'Link';
      block.attrs.href = get('href') || '#';
    } else if (block.tag === 'img') {
      block.attrs.src = get('src') || '';
      block.attrs.alt = get('alt') || '';
    } else if (block.tag === 'input') {
      block.attrs.type = get('type') || 'text';
      block.attrs.placeholder = get('placeholder') || '';
    }
    dlg.remove(); renderEditor(); updatePreview();
  });
}

function openSnippetProps(idx) {
  const block = model[idx];
  const dlg = document.createElement('dialog');
  dlg.innerHTML = `<form method="dialog"><h3>Modifica HTML dello snippet</h3>
    <textarea name="html" rows="10" style="font-family:ui-monospace,monospace">${escapeHTML(block.html)}</textarea>
    <menu><button value="cancel">Annulla</button>
    <button value="ok" type="submit">Salva</button></menu></form>`;
  document.body.appendChild(dlg); dlg.showModal();
  dlg.addEventListener('close', () => {
    if (dlg.returnValue === 'ok') {
      block.html = dlg.querySelector('[name="html"]').value;
      renderEditor(); updatePreview();
    }
    dlg.remove();
  });
}

/* ============================================================
   PALETTE — "la UI che ti permette di fare una certa cosa"
   ============================================================ */
document.querySelectorAll('[data-textblock]').forEach(btn =>
  btn.addEventListener('click', () => {
    model.push({ kind:'text', type: btn.dataset.textblock, runs:[{ text:'Nuovo testo…', marks:{} }] });
    renderEditor(); updatePreview();
  }));

document.querySelectorAll('[data-element]').forEach(btn =>
  btn.addEventListener('click', () => {
    const d = ELEMENT_DEFAULTS[btn.dataset.element];
    model.push({ kind:'element', tag:d.tag, text:d.text, attrs:{ ...d.attrs } });
    renderEditor(); updatePreview();
  }));

document.querySelectorAll('[data-snippet]').forEach(btn =>
  btn.addEventListener('click', () => {
    model.push({ kind:'snippet', name: btn.dataset.snippet, html: SNIPPETS[btn.dataset.snippet] });
    renderEditor(); updatePreview();
  }));

/* ============================================================
   FORMATTAZIONE INLINE (su blocco di testo attivo)
   ============================================================ */
document.querySelectorAll('[data-inline]').forEach(btn =>
  btn.addEventListener('mousedown', e => e.preventDefault()));

document.querySelectorAll('[data-inline]').forEach(btn =>
  btn.addEventListener('click', e => {
    e.preventDefault();
    const sel = window.getSelection();
    if (!sel.rangeCount) return;
    const node = sel.anchorNode?.nodeType === 1 ? sel.anchorNode : sel.anchorNode?.parentElement;
    if (!node?.closest('[contenteditable="true"]')) return;
    const cmd = btn.dataset.inline;
    if (cmd === 'bold') document.execCommand('bold');
    else if (cmd === 'italic') document.execCommand('italic');
    else if (cmd === 'link') {
      const url = prompt('URL:', 'https://');
      if (url) document.execCommand('createLink', false, url);
    }
    // sync del modello
    const ed = node.closest('[contenteditable="true"]');
    const idx = [...editorEl.querySelectorAll('.block')]
      .findIndex(b => b.contains(ed));
    if (idx >= 0) model[idx].runs = parseInlineNodes(ed.childNodes);
    updatePreview();
  }));

