function renderTextBlockHTML(b) {
  const inner = b.runs.map(renderRun).join('');
  const tag = {p:'p', h1:'h1', h2:'h2', h3:'h3', quote:'blockquote', li:'div'}[b.type] || 'p';
  return `<${tag}>${inner}</${tag}>`;
}

function renderRun(r) {
  let t = escapeHTML(r.text);
  const m = r.marks || {};
  if (m.link) t = `<a href="${escapeAttr(m.link)}">${t}</a>`;
  if (m.italic) t = `<em>${t}</em>`;
  if (m.bold) t = `<strong>${t}</strong>`;
  return t;
}

function renderElementHTML(b) {
  const attrs = Object.entries(b.attrs || {})
    .map(([k,v]) => ` ${k}="${escapeAttr(v)}"`).join('');
  if (b.tag === 'img' || b.tag === 'hr' || b.tag === 'input') {
    return `<${b.tag}${attrs}>`;
  }
  const inner = escapeHTML(b.text || '');
  return `<${b.tag}${attrs}>${inner}</${b.tag}>`;
}
